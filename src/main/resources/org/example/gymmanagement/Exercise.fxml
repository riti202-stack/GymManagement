<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.gymmanagement.ExerciseController"
      spacing="15"
      style="-fx-padding: 20; -fx-background-color: #f0f4f7;">

    <Label text="Exercise &amp; Timer"
           style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <!-- Exercise 1 -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Push Ups" prefWidth="100"/>
        <Label fx:id="timer1" text="00:00" prefWidth="60"/>
        <Label fx:id="reps1" text="0 reps" prefWidth="60"/>
        <Button text="Start" onAction="#startTimer1"/>
        <Button text="Pause" onAction="#pauseTimer1"/>
        <Button text="Stop" onAction="#stopTimer1"/>
        <Button text="+ Rep" onAction="#addRep1"/>
    </HBox>

    <!-- Exercise 2 -->
    <HBox spacing="10" alignment="CENTER_LEFT">
