    <!-- Attendance Button -->
    <Button fx:id="attendanceBtn"
            text="Mark Attendance"
            style="-fx-background-color: #4ca1af; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
            onAction="#markAttendance"
            prefHeight="40"
            prefWidth="200"/>
    <Button fx:id="backBtn"
            text="Back to User Panel"
            style="-fx-background-color: #4ca1af; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
            onAction="#goToUserPanel"
            prefHeight="40"
            prefWidth="200"/>

</VBox>
