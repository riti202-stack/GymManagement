<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.gymmanagement.MembersController"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox spacing="20" style="-fx-background-color: white; -fx-border-color: #dcdfe6; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
            <children>
                <Label text="👥 Members Management" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalMembersLabel" text="Total Members: 0"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db; -fx-padding: 8 20; -fx-background-color: #e8f4fd; -fx-background-radius: 20;"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <TableView fx:id="membersTable" prefHeight="500">
                <columns>
                    <!-- ✅ ALL fx:id's CORRECT -->
                    <TableColumn fx:id="memberIdCol" prefWidth="80" text="ID"/>
                    <TableColumn fx:id="nameCol" prefWidth="150" text="Name"/>
                    <TableColumn fx:id="emailCol" prefWidth="200" text="Email"/>
                    <TableColumn fx:id="firstLoginCol" prefWidth="140" text="First Login"/>
                    <TableColumn fx:id="latestPaymentCol" prefWidth="140" text="Latest Payment"/>
                    <TableColumn fx:id="totalPaidCol" prefWidth="120" text="Total Paid"/>
                    <TableColumn fx:id="latestWeightCol" prefWidth="120" text="Latest Weight"/>
                    <TableColumn fx:id="joinDateCol" prefWidth="120" text="Join Date"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-border-color: #dcdfe6; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <children>
                <Button fx:id="refreshBtn" text="🔄 Refresh" onAction="#refreshData"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25;"/>
                <Button fx:id="backBtn" text="← Back to Dashboard" onAction="#goBack"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
