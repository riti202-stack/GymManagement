<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>




    <BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"

                style="-fx-background-color: #f4f6f9;" fx:controller="org.example.gymmanagement.DashboardController" >


        <top>
            <HBox alignment="CENTER_LEFT"
                  spacing="20"
                  style="-fx-background-color: #2c3e50;
                     -fx-padding: 15;">
                <Label text=" Gym Management System"
                       style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;" />
            </HBox>
        </top>

        <left>
            <VBox spacing="15"
                  style="-fx-background-color: #34495e;
                     -fx-padding: 20;"
                  prefWidth="200">

                <Label text="Dashboard"
                       style="-fx-text-fill: white;
                          -fx-font-size: 14px;" />

                <Label text="Members" fx:id="membersLabel"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10;"
                       onMouseClicked="#showMembers"/>



                <!-- REPLACE your current Payments Label with this: -->
                <Label text="Payments"
                       fx:id="paymentsLabel"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10;"
                       onMouseClicked="#showPayments"/>



                <Label text="Logout"
                       style="-fx-text-fill: #e74c3c;
                          -fx-font-size: 14px;"
                       fx:id="logout"
                       onMouseClicked="#handleLogout"
                />
            </VBox>
        </left>


        <center>

            <VBox spacing="20"
                  style="-fx-padding: 25;">

                <Label text="Welcome Back"
                       style="-fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;" />

                <HBox spacing="20">

                    <StackPane prefWidth="220" prefHeight="120"
                               style="-fx-background-color: white;
                                  -fx-background-radius: 15;
                                  -fx-effect: drop shadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);">
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="Total Members" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="totalMembersLabel" text="128" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        </VBox>
                    </StackPane>


                    <StackPane prefWidth="220" prefHeight="120"
                               style="-fx-background-color: white;
                                  -fx-background-radius: 15;
                                  -fx-effect: drop shadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);">
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="Monthly Income" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="monthlyIncomeLabel" text="45,000" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                        </VBox>
                    </StackPane>




                </HBox>
            </VBox>

        </center>

    </BorderPane>



